# Server
PORT=
# Comma-separated list of origins allowed to call this API (your Vite dev server / production domain)
CORS_ORIGIN=

# Google Gemini — used to analyze the scraped page and draft the report content
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=

# OpenAI — used for the live "what would ChatGPT say" audit
OPENAI_API_KEY=
OPENAI_MODEL=

# Anthropic — used for the live "what would Claude say" audit
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# scrape.do — fetches the target product page (JS-rendered) so we can read specs/price/structured data
# https://scrape.do  (dashboard shows your token)
SCRAPE_DO_TOKEN=

# Bright Data — Web Unlocker / Web Access API key (used for the live search-visibility check)
# Still need the account's zone name from the Bright Data dashboard (Proxies & Scraping > your zone)
# for this to authenticate — code degrades gracefully (skips this section) until BRIGHTDATA_SERP_ZONE is set.
BRIGHTDATA_API_KEY=
BRIGHTDATA_SERP_ZONE=

# Gmail SMTP — sends the lead notification to LEAD_NOTIFY_EMAIL and the report copy to the visitor
# Use a 16-character Gmail "App Password" (Google Account > Security > App passwords), not your login password
GMAIL_USER=
GMAIL_APP_PASSWORD=
LEAD_NOTIFY_EMAIL=
# Extra inboxes (comma separated) that also get the team email when a visitor runs the CatalogWiz enrichment demo
# or generates an AI Readiness Report (the report email carries the PDF). They only receive; no app password needed.
LEAD_COPY_EMAILS=

# Newsletter signup (POST /api/subscribe) — MailerLite is the mailing list. Without a key the signup still works:
# addresses are kept in server/subscribers.json and LEAD_NOTIFY_EMAIL is emailed for each new one.
# Key: MailerLite > Integrations > API > Generate new token. Group id: MailerLite > Subscribers > Groups (the number in the URL).
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=
# true = create subscribers as "unconfirmed" so MailerLite sends its confirmation (double opt-in) email.
# Also switch on "Double opt-in for API and integrations" in MailerLite > Subscribe settings.
MAILERLITE_DOUBLE_OPT_IN=

# New-content announcements: when the website publishes a new article, event or case study, subscribers are emailed
# (one MailerLite campaign; MailerLite adds the unsubscribe link). Every build of the website publishes
# /resources-feed.json; the server reads it every ANNOUNCE_CHECK_MINUTES. The first check only records what already
# exists, so nobody is emailed about old content.
SITE_FEED_URL=
# The website's public address, used for links and images in the email (default: the origin of SITE_FEED_URL).
SITE_URL=
# A sender address you have verified in MailerLite (Account settings > Domains / Senders). Required to send.
NEWSLETTER_FROM_EMAIL=
NEWSLETTER_FROM_NAME=AltiusNxt
NEWSLETTER_REPLY_TO=
ANNOUNCE_CHECK_MINUTES=30

# Who the AI Readiness report is "prepared by" (shown on the cover and the next-steps page).
# Defaults: Govindaraj L, Business Unit Head, and OUTREACH_SENDER_EMAIL -> LEAD_NOTIFY_EMAIL.
OUTREACH_SENDER_NAME=
OUTREACH_SENDER_TITLE=
OUTREACH_SENDER_EMAIL=

# Outreach report tool (POST /api/outreach/generate) — internal, not linked from the public site.
# Send this back as the x-outreach-token header to use the endpoint.
OUTREACH_API_TOKEN=

# Google Places API — real review count/rating and formatted business address.
GOOGLE_PLACES_API_KEY=

# Mistral (OCR for PDF datasheets / spec diagrams on product pages)
MISTRAL_API_KEY=

# Owner's private usage dashboard (off unless BOTH of these are set). It is opened from the website by a hidden gesture on the
# copyright mark in the footer, then asks for this password. ADMIN_PATH is the secret address segment (16-64 letters, digits, - or _):
# make it long and random. Optional: ADMIN_SESSION_HOURS (default 12), ADMIN_TZ (default Asia/Kolkata), ADMIN_SESSION_SECRET.
ADMIN_PASSWORD=
ADMIN_PATH=

# HubSpot: saves name/email/company and utm_source/utm_medium/utm_campaign/utm_content as a contact
# whenever the AI Readiness form is submitted. A Private App token (HubSpot: Settings > Integrations
# > Private Apps > create one > scope "crm.objects.contacts.write") — not the tracking-code snippet.
# Off (no contact saved, nothing else affected) until this is set.
HUBSPOT_PRIVATE_APP_TOKEN=

# Cloudflare Turnstile (captcha) — bot-gates the contact form, the AI Readiness scan, and the CatalogWiz
# live demo. Create a free widget at https://dash.cloudflare.com/?to=/:account/turnstile, add this site's
# domain(s), then put the Secret Key here and the Site Key in the frontend's VITE_TURNSTILE_SITE_KEY.
# Off (no captcha check, forms work as before) until this is set.
TURNSTILE_SECRET_KEY=
